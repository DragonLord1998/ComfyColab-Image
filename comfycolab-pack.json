      "ref": "09ecbcc42576c88b25c7c160fc57b3ec412ecb60",
      "destination": "models/image/mage-flow-turbo",
      "scope": "mage-flow-worker",
      "install_phase": "lazy"
    },
    {
      "kind": "huggingface",
      "id": "mage-flow-edit-model",
      "repository": "microsoft/Mage-Flow-Edit",
      "ref": "79de4e0869566c20960ffa1c9ac8154a840f6eca",
      "destination": "models/image/mage-flow-edit",
      "scope": "mage-flow-worker",
      "install_phase": "lazy"
    },
    {
      "kind": "huggingface",
      "id": "mage-flow-edit-turbo-model",
