      "ref": "286ac4b5429ab803e63073c79c10c9a205793c86",
      "destination": "models/image/mage-flow-edit-turbo",
      "scope": "mage-flow-worker",
      "install_phase": "lazy"
    }
  ],
  "patches": [],
  "environments": [],
  "hooks": {
    "configure": {
      "path": "runtime/configure.py",
      "network": "none",
      "write_roots": [
        "pack_state"
      ],
      "timeout_seconds": 30
    },
    "doctor": {
      "path": "runtime/doctor.py",
      "network": "none",
      "write_roots": [],
      "timeout_seconds": 30
    },
    "runtime_env": {
      "path": "runtime/runtime_env.py",
      "network": "none",
      "write_roots": [],
      "timeout_seconds": 30
    }
  },
  "runtime_env": {},
  "workflows": [
    "workflows/comfycolab_mageflow.json",
    "workflows/comfycolab_mageflow_turbo.json",
    "workflows/comfycolab_mageflow_edit.json",
    "workflows/comfycolab_mageflow_edit_turbo.json",
    "workflows/comfycolab_pid_upscale.json"
  ],
  "probes": [
    {
      "phase": "post_clone",
